#!/usr/bin/env bash
# Rejects a push if any outgoing commit's author/committer email, or a
# Co-authored-by trailer, isn't a noreply address. Enable with:
#   git config core.hooksPath .githooks
set -euo pipefail

allowed='@users\.noreply\.github\.com$|^noreply@github\.com$|^noreply@anthropic\.com$'
zero="0000000000000000000000000000000000000000"

while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue
  # New branch: check only commits not already on a remote (GitHub-signed merge commits
  # are verified server-side by the required_signatures ruleset and are unknown locally).
  if [ "$remote_sha" = "$zero" ]; then
    range=("$local_sha" --not --remotes)
  else
    range=("$remote_sha..$local_sha")
  fi

  bad=0

  while IFS= read -r email; do
    [ -z "$email" ] && continue
    if ! echo "$email" | grep -qE "$allowed"; then
      echo "pre-push: non-noreply commit email: $email" >&2
      bad=1
    fi
  done < <(git log "${range[@]}" --format='%ae%n%ce' 2>/dev/null || true)

  while IFS= read -r trailer_email; do
    [ -z "$trailer_email" ] && continue
    if ! echo "$trailer_email" | grep -qE "$allowed"; then
      echo "pre-push: non-noreply Co-authored-by trailer: $trailer_email" >&2
      bad=1
    fi
  done < <(git log "${range[@]}" --format='%B' 2>/dev/null | grep -ioE 'co-authored-by:.*<[^>]+>' | grep -oE '<[^>]+>' | tr -d '<>' || true)

  # Every outgoing commit must carry a signature (%G?: N=none, B=bad, E=cannot check).
  while read -r sha status; do
    case "$status" in
      N|B|E) echo "pre-push: commit $sha is not validly signed (status $status)" >&2; bad=1 ;;
    esac
  done < <(git log "${range[@]}" --format='%H %G?' 2>/dev/null || true)

  if [ "$bad" != "0" ]; then
    echo "pre-push: blocked. Use a noreply email and signed commits (see CONTRIBUTING.md)." >&2
    exit 1
  fi
done

exit 0
